{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anatomy-lessons",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "anatomy.wesimai.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
